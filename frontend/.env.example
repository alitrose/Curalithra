# CURALITHRA Web Frontend — Environment Configuration Template
# Copy to .env.local for local development (NEVER commit .env.local)

# Base URL of the Spring Boot REST API (no trailing slash)
# Local dev (Vite proxy /api -> localhost:8080/api):
VITE_API_BASE_URL=http://localhost:8080/api

# For GitHub Pages CI builds, set GitHub Repository Variable VITE_API_BASE_URL to:
# https://curalithra-api.onrender.com/api
