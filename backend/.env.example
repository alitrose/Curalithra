# CURALITHRA Web Backend — Environment Configuration Template
# Copy to .env for local runs (NEVER commit .env)

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL JDBC connection
# Local: jdbc:postgresql://localhost:5432/curalithra
# Neon PostgreSQL (use Direct non-pooler host for Flyway advisory locks; omit channel_binding):
# jdbc:postgresql://<ep-host>.aws.neon.tech/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/curalithra
DB_USERNAME=curalithra
DB_PASSWORD=replace_with_db_password

# Secret key for HMAC-SHA256 JWT signing (minimum 32 random characters; mandatory in prod profile)
CURALITHRA_JWT_SECRET=replace_with_minimum_32_char_random_secret_key_here
CURALITHRA_JWT_EXPIRATION_MS=28800000

# Comma-separated browser origins allowed for CORS (origin only, no path)
# Local: http://localhost:5173
# GitHub Pages target: https://alitrose.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://alitrose.github.io

# Public Live Demo Mode (MUST remain false in private production; set true on public portfolio demo)
CURALITHRA_DEMO_ENABLED=false
CURALITHRA_DEMO_PASSWORD=
CURALITHRA_DEMO_SEED_ON_STARTUP=true

# Optional headless initial Admin bootstrap (only applies when users table is empty & demo disabled)
CURALITHRA_BOOTSTRAP_ENABLED=false
CURALITHRA_BOOTSTRAP_ADMIN_NAME=Hospital Administrator
CURALITHRA_BOOTSTRAP_ADMIN_USERNAME=admin
CURALITHRA_BOOTSTRAP_ADMIN_EMAIL=admin@curalithra.demo
CURALITHRA_BOOTSTRAP_ADMIN_PASSWORD=
CURALITHRA_BOOTSTRAP_SEED_DEMO=true
